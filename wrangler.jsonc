{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "sante-erp",
  "main": "src/worker.js",
  "compatibility_date": "2026-08-01",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "sante-erp-db",
      "database_id": "PENDIENTE"
    }
  ],
  "observability": { "enabled": true }
}
